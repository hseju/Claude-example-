{
  "name": "cozy-camp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cozy Camping World: a browser-based miniature 3D camping simulation",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src",
    "lint:format": "prettier --check src"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.1.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.16.3",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^5.1.0"
  }
}
