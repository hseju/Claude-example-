# Anthropic credentials (read by the SDK)
ANTHROPIC_API_KEY=

# Model + effort for the outfit breakdown
BOLLYLOOK_CLAUDE_MODEL=claude-opus-5-5
BOLLYLOOK_CLAUDE_EFFORT=medium

# Storage (SQLite db + catalog images)
BOLLYLOOK_DATA_DIR=data

# Protects /api/admin/*. Leave empty to disable the admin API.
BOLLYLOOK_ADMIN_TOKEN=

# Spend guards: only calls that reach Claude count; cached looks are free
BOLLYLOOK_ANALYSES_PER_IP_PER_MINUTE=5
BOLLYLOOK_MAX_ANALYSES_PER_DAY=1000

# Affiliate tracking. Links still work without these, they just earn nothing.
BOLLYLOOK_AMAZON_ASSOCIATE_TAG=
# Affiliate network deep-link templates; {url} is replaced with the encoded store URL
BOLLYLOOK_MYNTRA_AFFILIATE_TEMPLATE=
BOLLYLOOK_AJIO_AFFILIATE_TEMPLATE=
